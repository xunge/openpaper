# Copy to deploy.env, chmod 600, and fill in the values marked "必须修改".
# scripts/deploy/*.sh source this file. Do not commit deploy.env.

# ===== 必须修改 =====
SERVER_IP=192.0.2.10
CLIENT_DOMAIN=http://192.0.2.10
API_DOMAIN=http://192.0.2.10:8100

CLIENT_PORT=80
SERVER_PORT=8100
JOBS_PORT=8101
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5433
RABBITMQ_PORT=5673
REDIS_PORT=6380

DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_FAST_MODEL=deepseek-chat

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me

# 仅用于生成 server DATABASE_URL；compose 默认使用 postgres/postgres。
# 如果要真正改库密码，需要同时修改 docker-compose.dev.yml。
POSTGRES_PASSWORD=postgres

# MinerU
MINERU_GPU_ID=0
MINERU_IMAGE=mineru:4
MINERU_IMAGE_TAR=/tmp/mineru4.tar.gz
# MINERU_IMAGE_REGISTRY=registry.example.com/openpaper/mineru:4
MINERU_API_PORT=8000
MINERU_FILE_PARSE_PORT=8003
MINERU_TIER=standard
MINERU_DIR=/opt/mineru
# MINERU_WEBUI=1

# ===== 自托管策略 =====
UNLIMITED_USAGE=true
MAX_UPLOAD_SIZE_MB=200
ALLOW_LOCAL_REGISTRATION=true

# ===== 可选项 =====
# 只有部署 TTS 时才设置
# TTS_MODELS_DIR=/opt/models/qwen3-tts
# TTS_GPU_ID=1
# TTS_BASE_URL=http://tts-proxy:8000/v1
# TTS_MODEL=Qwen3-TTS-12Hz-1.7B-CustomVoice

# 生成脚本自动写入，通常不用手填
# JOBS_INTERNAL_SECRET=
# S3_BUCKET_NAME=openpaper
# S3_ENDPOINT_URL=http://192.0.2.10:9000
# S3_PUBLIC_URL=http://192.0.2.10:9000/openpaper
